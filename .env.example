# Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ragdb

# --- Embedding Model ---
# Options: openai | cohere | sentence_transformers
EMBEDDING_PROVIDER=cohere
COHERE_KEY=your-cohere-api-key-here
COHERE_MODEL=embed-english-v3.0
# OPENAI_API_KEY=your-openai-api-key-here  # if using OpenAI for embeddings

# --- LLM for Generation ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- Observability ---
# Options: langfuse | langsmith | none
OBSERVABILITY_PROVIDER=langfuse
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# LANGSMITH_API_KEY=your-langsmith-api-key  # if using LangSmith instead

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
